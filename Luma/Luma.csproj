<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/luma.ico</ApplicationIcon>
    <AssemblyName>Luma</AssemblyName>
    <Version>1.7.0</Version>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Company>Luma</Company>
    <Description>Ekranın, tam kararında.</Description>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/_/Luma</PathMap>
  </PropertyGroup>
  <ItemGroup><EmbeddedResource Include="Locales/*.json" LogicalName="Luma.Locales.%(Filename)%(Extension)" /></ItemGroup>
</Project>

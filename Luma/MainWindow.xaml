<Window x:Class="Luma.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Luma · Ekranın, tam kararında" Width="472" Height="808" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" Topmost="True" FontFamily="Segoe UI Variable, Segoe UI" Foreground="#F4F0E9" FontSize="12" UseLayoutRounding="True">
  <Border x:Name="Shell" Background="#14161D" BorderBrush="#373942" BorderThickness="1" CornerRadius="22" Margin="8">
    <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.32"/></Border.Effect>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="68"/></Grid.RowDefinitions>
      <Grid Margin="22,0,18,0" MouseLeftButtonDown="HeaderDrag">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Grid Width="28" Height="28" Margin="0,0,10,0"><Ellipse Fill="#FFC681" Width="25" Height="25"/><Ellipse Fill="#14161D" Width="15" Height="15" Margin="9,-7,0,0"/><Ellipse Fill="#FFE6C1" Width="5" Height="5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"/></Grid>
          <TextBlock Text="luma" FontSize="27" FontWeight="SemiBold" VerticalAlignment="Center"/>
          <Border Background="#21332C" CornerRadius="5" Margin="12,5,0,0" Padding="7,3" VerticalAlignment="Center"><TextBlock x:Name="StateBadge" Text="● AKTİF" Foreground="#9BD6B4" FontSize="9" FontWeight="SemiBold"/></Border>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <Button x:Name="PauseHeader" ToolTip="Renk filtresini duraklat / sürdür" Width="31" Height="31" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="PauseHeaderClick" AutomationProperties.Name="Renk filtresini duraklat veya sürdür"><TextBlock x:Name="PauseHeaderGlyph" Text="&#xE769;" FontFamily="Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center"/></Button>
          <Button x:Name="PinButton" ToolTip="Paneli açık tut" Width="31" Height="31" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="PinClick" AutomationProperties.Name="Paneli açık tut"><TextBlock Text="&#xE718;" FontFamily="Segoe Fluent Icons" FontSize="14" HorizontalAlignment="Center"/></Button>
          <Button ToolTip="Sistem tepsisine küçült · Esc" Width="31" Height="31" MinHeight="0" Padding="0" Background="Transparent" BorderThickness="0" Click="HideClick" AutomationProperties.Name="Sistem tepsisine küçült"><TextBlock Text="&#xE921;" FontFamily="Segoe Fluent Icons" FontSize="13" HorizontalAlignment="Center"/></Button>
        </StackPanel>
      </Grid>
      <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="22,0,22,16"><StackPanel x:Name="DisplayTabs" Orientation="Horizontal"/></ScrollViewer>
      <ScrollViewer x:Name="ContentScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="22,0,16,0" Padding="0,0,6,0"><StackPanel x:Name="ViewPanel" Margin="0,0,0,8"/></ScrollViewer>
      <Border x:Name="ToastBorder" Grid.Row="3" Background="#363024" CornerRadius="9" Margin="22,6,22,4" Padding="11,9" Visibility="Collapsed"><TextBlock x:Name="ToastText" TextWrapping="Wrap" Foreground="#FFDBA5" FontSize="11"/></Border>
      <Border Grid.Row="4" BorderBrush="#2A2D36" BorderThickness="0,1,0,0" Margin="0,4,0,0"><UniformGrid x:Name="NavPanel" Columns="5" Margin="8,5,8,8"/></Border>
    </Grid>
  </Border>
</Window>
